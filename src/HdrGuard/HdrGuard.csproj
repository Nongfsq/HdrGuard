<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\HdrGuard.ico</ApplicationIcon>
    <AssemblyName>HdrGuard</AssemblyName>
    <RootNamespace>HdrGuard</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\HdrGuard.ico" />
    <None Include="config.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\HdrGuard.svg" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HdrGuard.Tests" />
  </ItemGroup>

</Project>
